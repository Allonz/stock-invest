# Tiger OpenAPI 配置文件模板（复制为 tiger_openapi_config.properties 后填写，不入 Git）
# 生产环境推荐使用环境变量：
#   TIGER_OPENAPI_TIGER_ID
#   TIGER_OPENAPI_ACCOUNT
#   TIGER_OPENAPI_LICENSE
#   TIGER_OPENAPI_PRIVATE_KEY
#   TIGER_OPENAPI_ENV
#
# 本地开发 fallback 文件：src/main/resources/tiger_openapi_config.properties（已被 .gitignore 忽略）

tiger_id=
account=
license=
env=PROD
# 优先使用 pk8；缺失时回退 private_key_pk1
private_key_pk8=
private_key_pk1=
